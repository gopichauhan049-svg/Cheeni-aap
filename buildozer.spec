[app]
title = Chini Assistant
package.name = chini
package.domain = org.chini
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 0.1
requirements = python3,kivy
orientation = portrait
fullscreen = 0

android.api = 33
android.minapi = 21
android.sdk_build_tools = 33.0.2
android.ndk = 25b
android.accept_sdk_license = True

[buildozer]
log_level = 2
warn_on_root = 1
